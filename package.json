{
  "name": "site-web-bbf",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-config-sync.mjs",
    "check:config": "node scripts/check-config-sync.mjs",
    "check:build": "node scripts/check-build.mjs && html-validate \"dist/**/*.html\"",
    "check:a11y": "node scripts/check-a11y.mjs",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build && npm run check:build",
    "cms:update": "node -e \"require('fs').copyFileSync('node_modules/@sveltia/cms/dist/sveltia-cms.js','public/admin/sveltia-cms.js')\"",
    "demo:images": "node scripts/generate-demo-assets.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@sveltia/cms": "0.250.2",
    "axe-core": "4.14.0",
    "html-validate": "11.17.0",
    "js-yaml": "5.5.0",
    "playwright": "1.56.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
