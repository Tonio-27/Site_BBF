---
// Demo-only notice. Hidden in production by building with PUBLIC_BETA=false.
const actif = import.meta.env.PUBLIC_BETA !== 'false';
---
{actif && (
  <div class="beta" role="region" aria-label="Site de démonstration">
    <strong>Site de démonstration</strong> — textes, noms et photos sont fictifs.
    <a href="/admin/">Essayer l’interface d’édition →</a>
  </div>
)}
<style>
  .beta { background: #fff4c2; color: #3d3200; font-size: var(--t-sm); text-align: center; padding: 0.4rem 1rem; border-bottom: 1px solid #e6d27a; }
  .beta a { color: #3d3200; font-weight: 700; margin-left: var(--e-2); white-space: nowrap; }
</style>
