---
import Base from '../layouts/Base.astro';
import BandeauPage from '../components/BandeauPage.astro';
---
<Base titre="Page introuvable" noindex>
  <BandeauPage titre="Page introuvable" surtitre="Erreur 404" intro="Cette page n'existe pas ou a été déplacée. Voici quelques pistes :" />
  <section class="section conteneur">
    <ul class="pistes">
      <li><a class="bouton" href="/">Accueil</a></li>
      <li><a class="bouton bouton--contour" href="/agenda/">Agenda</a></li>
      <li><a class="bouton bouton--contour" href="/blog/">Actualités</a></li>
      <li><a class="bouton bouton--contour" href="/contact/">Contact</a></li>
    </ul>
  </section>
</Base>
<style>
  .pistes { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--e-3); }
</style>
