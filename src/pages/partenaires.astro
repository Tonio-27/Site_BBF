---
import { getEntry } from 'astro:content';
import LogoPartenaire from '../components/LogoPartenaire.astro';
import Base from '../layouts/Base.astro';
import BandeauPage from '../components/BandeauPage.astro';
import { partenairesActifs } from '../lib/contenu.ts';
import { CATEGORIES_PARTENAIRE } from '../lib/schemas.ts';

const page = (await getEntry('page_partenaires', 'partenaires'))!.data;
const partenaires = await partenairesActifs();
const categories = CATEGORIES_PARTENAIRE.map((c) => ({ c, liste: partenaires.filter((p) => p.data.categorie === c) })).filter((x) => x.liste.length);
---
<Base titre="Partenaires" description="Les partenaires et sponsors du Brass Band Fribourg.">
  <BandeauPage titre="Partenaires" surtitre="Merci !" intro={page.remerciements} />
  {categories.map(({ c, liste }, i) => (
    <section class:list={['section', { 'section--gris': i % 2 }]} aria-labelledby={`cat-${i}`}>
      <div class="conteneur">
        <h2 id={`cat-${i}`}>{c === 'Partenaire principal' ? 'Partenaires principaux' : `${c}s`}</h2>
        <ul class="logos">
          {liste.map((p) => (
            <li>
              {p.data.site_web ? (
                <a href={p.data.site_web} rel="noopener"><LogoPartenaire logo={p.data.logo} nom={p.data.nom} largeur={240} /></a>
              ) : (
                <LogoPartenaire logo={p.data.logo} nom={p.data.nom} largeur={240} />
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
  <section class="section section--noir" aria-labelledby="t-soutenir">
    <div class="conteneur appel-soutien">
      <p class="surtitre">Nous soutenir</p>
      <h2 id="t-soutenir">Votre entreprise à nos côtés</h2>
      <p>Plusieurs formules de sponsoring, adaptées à chaque budget.</p>
      <a class="bouton" href="/soutenir/#sponsoring">Voir les formules</a>
    </div>
  </section>
</Base>
<style>
  .logos { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--e-4); grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); }
  .logos li { background: var(--blanc); border-radius: var(--rayon-lg); padding: var(--e-3); box-shadow: var(--ombre); }
  .logos a { display: block; }
  .appel-soutien p:not(.surtitre) { color: #d6d6d6; }
</style>
